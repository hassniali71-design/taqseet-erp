SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same project URL/anon key as above, duplicated under the VITE_ prefix Vite requires to
# expose a variable to browser-side code (src/lib/supabase-client.ts). The anon key is safe
# to ship to the browser — Row Level Security on the Supabase side is what actually protects
# data, not secrecy of this key. Never add a VITE_ prefix to SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (src/lib/twilio-server.ts) — never add a VITE_ prefix, same reasoning as
# SUPABASE_SERVICE_ROLE_KEY above: the missing prefix is what keeps these out of the client
# bundle by construction. TWILIO_WHATSAPP_FROM should include the "whatsapp:" prefix Twilio
# expects (e.g. "whatsapp:+14155238886" for the Sandbox number while awaiting Meta approval
# for a real WhatsApp Business sender).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
