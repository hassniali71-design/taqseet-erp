SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same project URL/anon key as above, duplicated under the VITE_ prefix Vite requires to
# expose a variable to browser-side code (src/lib/supabase-client.ts). The anon key is safe
# to ship to the browser — Row Level Security on the Supabase side is what actually protects
# data, not secrecy of this key. Never add a VITE_ prefix to SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
